<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>vsix-admin-128.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="vsix-admin-128.ico" />
    <Resource Include="vsix-plain-128.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Non-adorner selection so SelectionTextBrush can render white password dots. -->
    <RuntimeHostConfigurationOption Include="Switch.System.Windows.Controls.Text.UseAdornerForTextboxSelectionRendering" Value="false" />
  </ItemGroup>

</Project>
